# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/ziwei
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/ziwei

# Required secrets (replace all values; no defaults are permitted)
SESSION_SECRET=replace-with-a-random-value-at-least-24-characters
PHASE10_ADMIN_TOKEN=replace-with-a-random-value-at-least-24-characters
STRIPE_WEBHOOK_SECRET=replace-with-your-provider-signing-secret

# Data protection
ZIWEI_BIRTH_DATA_ENCRYPTION_KEY=replace-with-a-random-value-at-least-24-characters

# Observability (required for production readiness)
OBS_LOG_SINK=https://logs.example.invalid/ingest
OBS_METRICS_ENDPOINT=https://metrics.example.invalid/ingest
OBS_ALERT_WEBHOOK_URL=https://alerts.example.invalid/webhook
OBS_ALERT_WEBHOOK_SECRET=replace-with-a-random-value-at-least-24-characters
OBS_TRACE_EXPORTER=https://traces.example.invalid/ingest
OBS_BACKUP_HEALTHCHECK_URL=https://backup.example.invalid/health

# Operations and rate limiting
PHASE10_OPS_MFA_ENABLED=true
PHASE10_OPS_MFA_CODE=replace-with-a-managed-mfa-code
ZIWEI_RATE_LIMIT_REDIS_REQUIRED=true
ZIWEI_RATE_LIMIT_REDIS_URL=redis://localhost:6379
